apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: ${git_interval}
  url: ${git_url}
  ref:
    branch: ${git_branch}
  secretRef:
    name: ${git_secret_name}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flux-system
  namespace: flux-system
spec:
  interval: ${kustomization_interval}
  path: ${git_path}
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
  postBuild:
    substituteFrom:
      - kind: ConfigMap
        name: infra-outputs
%{ if sops_secret_name != "" ~}
  decryption:
    provider: sops
    secretRef:
      name: ${sops_secret_name}
%{ endif ~}
